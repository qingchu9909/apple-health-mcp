# Copy to /opt/health/.env (chmod 640, group = the service user).
# deploy/install.sh writes this file for you and keeps existing tokens.
# Generate each token with:  openssl rand -hex 32

# Health Auto Export sends `Authorization: Bearer $HEALTH_TOKEN` to /ingest.
HEALTH_TOKEN=replace-me-with-a-64-char-hex-string
# Secret path of the Claude connector: https://<domain>/mcp/<MCP_PATH_TOKEN>.
# Claude's connector UI cannot send custom headers, so the token lives in the
# URL. Falls back to HEALTH_TOKEN when unset; keep them different so a leaked
# connector URL cannot be used to upload data and vice versa.
MCP_PATH_TOKEN=replace-me-with-another-64-char-hex-string
# Bearer token for GET /api/bundle and POST /api/report, used by the scheduled
# daily-report routine. The /api routes answer 503 while it is unset.
REPORT_API_TOKEN=replace-me-with-a-third-64-char-hex-string

# Your time zone. "Today", "last N days" and report dates follow it.
USER_TZ=Asia/Shanghai

# Ingested CSV exports, saved daily reports, and one JSON file per workout,
# night (sleep times), ECG recording and heart rate notification.
DATA_DIR=/opt/health/data
REPORTS_DIR=/opt/health/reports
WORKOUTS_DIR=/opt/health/workouts
SLEEP_DIR=/opt/health/sleep
ECG_DIR=/opt/health/ecg
HR_NOTIFICATIONS_DIR=/opt/health/hr-notifications

# Push channels for the daily report (configure any subset).
# Telegram: create a bot with @BotFather, send it a message, then
# https://api.telegram.org/bot<token>/getUpdates shows your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WeChat via Server酱 (https://sct.ftqq.com, SCT... or sctp... keys).
SERVERCHAN_SENDKEY=
# WeChat via PushPlus (https://www.pushplus.plus).
PUSHPLUS_TOKEN=
